##5: Kullanıcıdan kaç adet ürün eklemek istediğini alarak, 
#her ürünün adını ve fiyatını isteyip,
#sonrasında eklenen tüm ürünleri listeleyen 
#bir Python programı yazınız.
urunler = []
adet = int(input("kaç ürün eklenecek: "))
i = 0
while i < adet:
    name = input("ürün ismi: ")
    price = input("fiyat: ")
    urunler.append({
        "name": name,
        "price": price
    })
    i += 1
i = 0
while i < len(urunler):
    print(f"ürün adı: {urunler[i]["name"]}, ürün fiyatı: {urunler[i]["price"]}")
    i += 1

##6:Sayı tahmin. hak kullanıcıdan al. 100 üzerinden puanlama
#her soru 20puan
hak = int(input("Hak sayısı: ").strip())  
import random
tahminSayisi = random.randint(1,100)
puan = 100
puanlama = puan/hak
sayac = 0
while hak > 0:
    try:
        tahmin = int(input("Tahmininiz: ").strip())
    except ValueError:
        print("Lütfen geçerli bir tam sayı girin.")
        continue
    sayac += 1
    hak -= 1
    if tahmin == tahminSayisi:
        print("Tebrikler {} bildiniz!".format(sayac))
        print("toplam puanınız: {}".format(100 - puanlama * (sayac-1)))
        break
    elif tahmin < tahminSayisi:
        print("sayı yukarıda.")
        print("kalan hakkınız: ", hak)
    elif tahmin > tahminSayisi:
        print("sayı aşağıda.")
        print("kalan hakkınız: ", hak)
        
if hak == 0:
    print("Hakkınız bitti.")
    print("Tahmin edilecek sayı {}.".format(tahminSayisi))

