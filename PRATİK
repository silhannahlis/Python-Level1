print("2 en küçük asal sayıdır. 2'den büyük sayı giriniz")
asal = True
while True:
    try:
        sayi = int(input("Sayı: "))
        if sayi < 2:
            print("2'den büyük sayı giriniz.") 
            continue
        break            
    except:
        print("2'den büyük sayı giriniz.")  
for i in range(2, int(sayi*0.5)+1):
    if sayi % i == 0:
        asal = False
        break
if asal == True:
    print("{} sayısı asaldır".format(sayi))
else:
    print("{} sayısı asal değildir".format(sayi))
     
